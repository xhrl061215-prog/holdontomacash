{
  "name": "budget-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "verify:db": "node supabase/verify-migrations.mjs",
    "preview": "vite preview",
    "dev:api": "node server/index.mjs",
    "verify:e2e": "node server/e2e.mjs",
    "dev:all": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev\"",
    "verify:reconcile": "node server/reconcile.mjs",
    "verify:seed": "node supabase/verify-seed-migration.mjs",
    "verify:limitations": "node server/verify-limitations.mjs",
    "verify:overview-fn": "node supabase/verify-overview-function.mjs",
    "build:setup-sql": "node scripts/build-setup-sql.mjs",
    "verify:setup-sql": "node supabase/verify-setup-sql.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.3",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
